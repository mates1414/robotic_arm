# ─── ROS / catkin build artifacts ───────────────────────────────
# The repo root doubles as a catkin workspace `src/`; build outputs
# land here when building natively (in Docker they're inside the
# mounted workspace). None of it belongs in version control.
build/
devel/
install/
logs/
.catkin_workspace
*.catkin_tools/
.catkin_tools/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
install_manifest.txt

# ─── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/

# ─── Editor / IDE / OS junk ─────────────────────────────────────
*~
*.swp
*.swo
.idea/
.vscode/
.directory
.DS_Store
Thumbs.db

# ─── ROS logs ───────────────────────────────────────────────────
*.bag
.ros/
