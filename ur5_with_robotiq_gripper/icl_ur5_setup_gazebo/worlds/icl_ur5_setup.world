<?xml version="1.0" ?>
<sdf version="1.4">

  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Stable contact physics. The default contact_max_correcting_vel (100 m/s)
         flings light objects across the room the instant the gripper touches
         them; capping it (plus a small surface layer and more solver iterations)
         keeps the cube put so it can actually be grasped. -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

<!--    <include>
      <uri>model://kinect_ros</uri>
      <pose>0.5 -0.5 0 0 0 1.570795</pose>
    </include> -->


    <!-- Thin static shelf the cube rests on (top at z=1.375). It must stay thin
         and at the cube's bottom height: the robot base is at z=1.2 and the arm
         links sweep just below ~z=1.35, so a full-height table block would spawn
         INSIDE the arm and blow the physics up. This shelf sits just above that
         sweep. -->
    <model name='cube_stand'>
      <static>true</static>
      <pose>0.4 0.1 1.37 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.16 0.16 0.01</size>
            </box>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.16 0.16 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pickable cube with an AprilTag on top. NOT static, so the gripper can
         actually lift it. It rests on the work table (bottom at z=1.375).
         High friction + the gazebo_grasp_fix plugin (in the robot URDF) make
         the parallel-jaw grasp hold reliably in Gazebo. -->
    <model name='apriltag_cube'>
      <!-- Spawn a couple cm above the table top (z=1.375) so it settles gently
           instead of exploding out of an exact-boundary contact. -->
      <pose>0.4 0.1 1.41 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>8.33e-5</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>8.33e-5</iyy>
            <iyz>0</iyz>
            <izz>8.33e-5</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
            <contact>
              <ode><kp>1e5</kp><kd>1.0</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode>
            </contact>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <script>
              <!-- Paths are relative to GAZEBO_RESOURCE_PATH. icl_ur5_setup_description
                   exports its package root there via <gazebo_ros gazebo_media_path>
                   in package.xml, so these resolve in or out of Docker. -->
              <uri>materials/scripts</uri>
              <uri>materials/textures</uri>
              <name>AprilTag/Cube</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
