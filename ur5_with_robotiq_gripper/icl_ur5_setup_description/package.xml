<?xml version="1.0"?>
<package format="2">
  <name>icl_ur5_setup_description</name>
  <version>0.0.1</version>
  <description>UR5 arm with Robotiq ARG140 Gripper Description</description>
  <maintainer email="ryan@rwsinnet.com.com">Ryan Sinnet</maintainer>
  <author email="ryan@rwsinnet.com">Ryan Sinnet</author>
  <maintainer email="ygao73@jhu.edu">Yuxiang Gao</maintainer>
  <author email="ygao73@jhu.edu">Yuxiang Gao</author>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>urdf</exec_depend>
  <!-- Required so Gazebo's paths plugin ingests the gazebo_media_path export
       below (rospack only inspects exports of packages that depend on gazebo_ros).
       Without this the relative material <uri>s in the world won't resolve. -->
  <exec_depend>gazebo_ros</exec_depend>

  <export>
    <gazebo_ros gazebo_media_path="${prefix}"/>
  </export>
</package>
