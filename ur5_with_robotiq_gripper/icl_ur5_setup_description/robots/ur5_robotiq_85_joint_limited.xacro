<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="ur5_gripper">
  <!-- include macros for UR5 and the Robotiq eef model -->
  <xacro:include filename="$(find ur_description)/urdf/common.gazebo.xacro" />
  <xacro:include filename="$(find ur_description)/urdf/ur5.xacro" />
  <xacro:include filename="$(find icl_ur5_setup_description)/urdf/robotiq_arg2f_85_model_macro.xacro" />
  <xacro:include filename="$(find icl_ur5_setup_description)/urdf/realsense.xacro" />
  <!-- <xacro:include filename="$(find icl_ur5_setup_description)/urdf/robotiq_fts300.urdf.xacro" /> -->
  
  <xacro:macro name="ur5_with_gripper_joint_limited" params="prefix">
    <!-- arm -->
    <!-- <xacro:ur5_robot prefix="${prefix}" joint_limited="true" 
      shoulder_pan_lower_limit="${-3*pi/4}" shoulder_pan_upper_limit="${pi/2}"
      shoulder_lift_lower_limit="${-pi*7/8}" shoulder_lift_upper_limit="${-pi/8}"
      elbow_joint_lower_limit="${-pi}" elbow_joint_upper_limit="${pi}"
      wrist_1_lower_limit="${-pi}" wrist_1_upper_limit="${pi}"
      wrist_2_lower_limit="${-pi}" wrist_2_upper_limit="${pi}"
      wrist_3_lower_limit="${-pi}" wrist_3_upper_limit="${pi}"
    /> -->
  
    <link name="world" />
    <joint name="fixed_link_robot_base" type="fixed">
      <parent link= "world" />
      <child link = "${prefix}base_link" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </joint>

    <!--force torque sensor-->
    <!-- <xacro:robotiq_fts150 prefix="" parent="ee_link" >
      <origin xyz="0.009 0 0 " rpy="-${pi/2} 0 -${pi/2}"/>
    </xacro:robotiq_fts150> -->

   <!-- gripper -->
    <xacro:robotiq_arg2f_85 prefix="${prefix}" />
    <joint name="ur5_ee_link_gripper_base" type="fixed">
      <parent link= "${prefix}tool0" />
      <child link = "${prefix}robotiq_arg2f_base_link" />
      <origin xyz=" 0.0 0.0 0.0" rpy="0.0 0.0 ${pi/2}" />
    </joint>
    
    <!-- TCP (Tool Center Point) - gripper finger tips grasp point -->
    <!-- This represents where objects should be positioned for grasping -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="gripper_tcp_joint" type="fixed">
      <parent link="${prefix}tool0"/>
      <child link="${prefix}gripper_tcp"/>
      <!-- Robotiq 85: ~17cm from tool0 to finger tips when fingers are centered -->
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
    </joint> 

    <!-- Wrist-mounted depth (RGB-D) camera — defined in realsense.xacro -->
    <xacro:realsense_camera parent="${prefix}wrist_3_link"/>

    <!-- <link name="${prefix}tool" />
    <joint name="tool_tip" type="fixed">
      <parent link= "${prefix}tool0" />
      <child link = "${prefix}tool" />
      <origin xyz=" 0.00 0.0 0.2" rpy="0.0 0.0 0.0" />
    </joint> -->
  </xacro:macro>

  <xacro:ur5_with_gripper_joint_limited prefix=""/>

  <!-- Grasp-fix plugin. Robotiq parallel grasps are unreliable in Gazebo classic
       (the cube slips out from between the finger pads). This plugin detects a
       stable grip between the gripper links and an object, attaches it to the
       palm with a temporary fixed joint, and releases when the gripper opens.
       Provided by ros-noetic-roboticsgroup-upatras-gazebo-plugins. -->
  <gazebo>
    <plugin name="gazebo_grasp_fix" filename="libgazebo_grasp_fix.so">
      <arm>
        <arm_name>ur5_gripper</arm_name>
        <!-- Gazebo lumps fixed-jointed links into their parent: the gripper base
             (robotiq_arg2f_base_link) merges into wrist_3_link, and the
             *_finger_tip links merge into the *_inner_finger links. So use the
             real Gazebo link names here, not the URDF ones. -->
        <palm_link>wrist_3_link</palm_link>
        <gripper_link>left_inner_finger</gripper_link>
        <gripper_link>right_inner_finger</gripper_link>
      </arm>
      <forces_angle_tolerance>120</forces_angle_tolerance>
      <update_rate>15</update_rate>
      <grip_count_threshold>1</grip_count_threshold>
      <max_grip_count>3</max_grip_count>
      <release_tolerance>0.008</release_tolerance>
      <!-- Once a grip is detected, stop the fingers colliding with the object so
           the position-controlled gripper can't crush/launch the light cube. -->
      <disable_collisions_on_attach>true</disable_collisions_on_attach>
      <contact_topic>__default_topic__</contact_topic>
    </plugin>
  </gazebo>
</robot>
