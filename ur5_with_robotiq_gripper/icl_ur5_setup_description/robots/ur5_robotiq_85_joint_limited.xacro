<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="ur5_gripper">
  <!-- include macros for UR5 and the Robotiq eef model -->
  <xacro:include filename="$(find ur_description)/urdf/common.gazebo.xacro" />
  <xacro:include filename="$(find ur_description)/urdf/ur5.xacro" />
  <xacro:include filename="$(find icl_ur5_setup_description)/urdf/robotiq_arg2f_85_model_macro.xacro" />
  <!-- <xacro:include filename="$(find icl_ur5_setup_description)/urdf/robotiq_fts300.urdf.xacro" /> -->
  
  <xacro:macro name="ur5_with_gripper_joint_limited" params="prefix">
    <!-- arm -->
    <!-- <xacro:ur5_robot prefix="${prefix}" joint_limited="true" 
      shoulder_pan_lower_limit="${-3*pi/4}" shoulder_pan_upper_limit="${pi/2}"
      shoulder_lift_lower_limit="${-pi*7/8}" shoulder_lift_upper_limit="${-pi/8}"
      elbow_joint_lower_limit="${-pi}" elbow_joint_upper_limit="${pi}"
      wrist_1_lower_limit="${-pi}" wrist_1_upper_limit="${pi}"
      wrist_2_lower_limit="${-pi}" wrist_2_upper_limit="${pi}"
      wrist_3_lower_limit="${-pi}" wrist_3_upper_limit="${pi}"
    /> -->
  
    <link name="world" />
    <joint name="fixed_link_robot_base" type="fixed">
      <parent link= "world" />
      <child link = "${prefix}base_link" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </joint>

    <!--force torque sensor-->
    <!-- <xacro:robotiq_fts150 prefix="" parent="ee_link" >
      <origin xyz="0.009 0 0 " rpy="-${pi/2} 0 -${pi/2}"/>
    </xacro:robotiq_fts150> -->

   <!-- gripper -->
    <xacro:robotiq_arg2f_85 prefix="${prefix}" />
    <joint name="ur5_ee_link_gripper_base" type="fixed">
      <parent link= "${prefix}tool0" />
      <child link = "${prefix}robotiq_arg2f_base_link" />
      <origin xyz=" 0.0 0.0 0.0" rpy="0.0 0.0 ${pi/2}" />
    </joint>
    
    <!-- TCP (Tool Center Point) - gripper finger tips grasp point -->
    <!-- This represents where objects should be positioned for grasping -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="gripper_tcp_joint" type="fixed">
      <parent link="${prefix}tool0"/>
      <child link="${prefix}gripper_tcp"/>
      <!-- Robotiq 85: ~17cm from tool0 to finger tips when fingers are centered -->
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
    </joint> 

    <!-- Camera link -->
    <link name="realsense_link">
      <visual>
        <geometry>
          <box size="0.04 0.04 0.025"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.04 0.04 0.025"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.07"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Fixed joint to attach camera to wrist_3_link, offset up and forward -->
    <joint name="realsense_joint" type="fixed">
      <parent link="${prefix}wrist_3_link"/>
      <child link="realsense_link"/>
      <origin xyz="0 0.06 0.01" rpy="0.0 -1.5708 1.5708"/>
    </joint>

    <!-- Optical frame for camera (ROS optical convention: X=right, Y=down, Z=forward) -->
    <link name="realsense_color_optical_frame"/>
    
    <joint name="realsense_optical_joint" type="fixed">
      <parent link="realsense_link"/>
      <child link="realsense_color_optical_frame"/>
      <!-- Rotate from camera body frame to optical frame:
           Camera body: X=forward, Y=left, Z=up
           Optical: X=right, Y=down, Z=forward
           Rotation: -pi/2 around X, then -pi/2 around Z -->
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <!-- <link name="${prefix}tool" />
    <joint name="tool_tip" type="fixed">
      <parent link= "${prefix}tool0" />
      <child link = "${prefix}tool" />
      <origin xyz=" 0.00 0.0 0.2" rpy="0.0 0.0 0.0" />
    </joint> -->
  </xacro:macro>

  <xacro:ur5_with_gripper_joint_limited prefix=""/>

 <!-- Camera Plugin -->
  <gazebo reference="realsense_link">
    <sensor type="camera" name="realsense_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>5.0</far>
        </clip>
      </camera>
      <plugin name="realsense_camera_controller" filename="libgazebo_ros_camera.so">
        <robotNamespace>/ur5</robotNamespace>
        <cameraName>realsense</cameraName>
        <imageTopicName>camera/image_raw</imageTopicName>
        <cameraInfoTopicName>camera/camera_info</cameraInfoTopicName>
        <frameName>realsense_color_optical_frame</frameName>
        <hackBaseline>0.07</hackBaseline>
      </plugin>
    </sensor>
  </gazebo>
</robot>
