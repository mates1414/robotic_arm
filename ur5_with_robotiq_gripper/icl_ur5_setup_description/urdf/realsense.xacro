<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Wrist-mounted depth (RGB-D) camera used for AprilTag detection.
       Single source of truth for the camera link, mount joint, optical frame
       and Gazebo sensor. Include this file and call the macro from the robot
       xacro instead of duplicating the camera inline.

       The Gazebo plugin publishes, in the ROS optical frame
       'realsense_color_optical_frame':
         /ur5/realsense/camera/image_raw         (sensor_msgs/Image, RGB)   <- AprilTag uses this
         /ur5/realsense/camera/camera_info       (sensor_msgs/CameraInfo)   <- AprilTag uses this
         /ur5/realsense/camera/depth/image_raw   (sensor_msgs/Image, depth) <- available for future use
         /ur5/realsense/camera/depth/points      (sensor_msgs/PointCloud2)  <- available for future use -->
  <xacro:macro name="realsense_camera" params="parent">

    <!-- Physical camera body (dimensions unchanged) -->
    <link name="realsense_link">
      <visual>
        <geometry>
          <box size="0.025 0.09 0.025"/>
        </geometry>
        <material name="camera_grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.025 0.09 0.025"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.072"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
      </inertial>
    </link>

    <!-- Mount the camera on the wrist, offset up and forward -->
    <joint name="realsense_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="realsense_link"/>
      <origin xyz="0 0.06 0.01" rpy="0 -1.5708 1.5708"/>
    </joint>

    <!-- Optical frame (ROS optical convention: X=right, Y=down, Z=forward) -->
    <link name="realsense_color_optical_frame"/>
    <joint name="realsense_optical_joint" type="fixed">
      <parent link="realsense_link"/>
      <child link="realsense_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <!-- Two co-located Gazebo sensors on the same link/optical frame:

         1) RGB camera (libgazebo_ros_camera.so) -> camera/image_raw +
            camera/camera_info. The plain camera plugin publishes camera_info in
            the RGB image callback, which is what AprilTag subscribes to.
         2) Depth camera (libgazebo_ros_depth_camera.so) -> camera/depth/image_raw
            + camera/depth/points, for future depth-based work.

         A single depth plugin is intentionally NOT used for both: it only emits
         camera_info when the depth stream is consumed, so AprilTag (RGB-only)
         would receive 0 camera_info messages and never detect a tag. The depth
         sensor's RGB-side outputs are renamed so they don't collide with (1). -->
    <gazebo reference="realsense_link">

      <sensor type="camera" name="realsense_color">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>5.0</far>
          </clip>
        </camera>
        <plugin name="realsense_color_controller" filename="libgazebo_ros_camera.so">
          <robotNamespace>/ur5</robotNamespace>
          <cameraName>realsense</cameraName>
          <frameName>realsense_color_optical_frame</frameName>
          <imageTopicName>camera/image_raw</imageTopicName>
          <cameraInfoTopicName>camera/camera_info</cameraInfoTopicName>
          <hackBaseline>0.07</hackBaseline>
        </plugin>
      </sensor>

      <sensor type="depth" name="realsense_depth">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>5.0</far>
          </clip>
        </camera>
        <plugin name="realsense_depth_controller" filename="libgazebo_ros_depth_camera.so">
          <robotNamespace>/ur5</robotNamespace>
          <cameraName>realsense</cameraName>
          <frameName>realsense_color_optical_frame</frameName>
          <imageTopicName>camera/depth/color_image_raw</imageTopicName>
          <cameraInfoTopicName>camera/depth/color_camera_info</cameraInfoTopicName>
          <depthImageTopicName>camera/depth/image_raw</depthImageTopicName>
          <depthImageCameraInfoTopicName>camera/depth/camera_info</depthImageCameraInfoTopicName>
          <pointCloudTopicName>camera/depth/points</pointCloudTopicName>
          <pointCloudCutoff>0.1</pointCloudCutoff>
          <pointCloudCutoffMax>5.0</pointCloudCutoffMax>
          <hackBaseline>0.07</hackBaseline>
        </plugin>
      </sensor>

    </gazebo>

  </xacro:macro>
</robot>
