<?xml version="1.0"?>
<!-- move_group for the UR5 + Robotiq 2F-85: planning pipelines OMPL (default), Pilz and CHOMP, trajectory execution
     through moveit_simple_controller_manager.

     Condensed from the Noetic MoveIt Setup Assistant template: each pipeline's plugin and request adapters are in its
     config/*_planning.yaml. The URDF is not loaded here; it comes from the robot_description parameter set by the
     simulation (or a driver). -->
<launch>
  <arg name="pipeline" default="ompl" doc="Default planning pipeline (ompl, pilz_industrial_motion_planner, chomp)"/>
  <arg name="allow_trajectory_execution" default="true"/>
  <arg name="debug" default="false" doc="Run move_group in gdb?"/>

  <arg name="config" value="$(find ur5_robotiq_moveit_config)/config"/>

  <param name="robot_description_semantic" textfile="$(arg config)/ur5_robotiq.srdf"/>
  <group ns="robot_description_planning">
    <rosparam command="load" file="$(arg config)/joint_limits.yaml"/>
    <rosparam command="load" file="$(arg config)/cartesian_limits.yaml"/>
  </group>
  <group ns="robot_description_kinematics">
    <rosparam command="load" file="$(arg config)/kinematics.yaml"/>
  </group>

  <group ns="move_group">
    <rosparam ns="planning_pipelines/ompl" command="load" file="$(arg config)/ompl_planning.yaml"/>
    <rosparam ns="planning_pipelines/pilz_industrial_motion_planner" command="load"
              file="$(arg config)/pilz_industrial_motion_planner_planning.yaml"/>
    <rosparam ns="planning_pipelines/chomp" command="load" file="$(arg config)/chomp_planning.yaml"/>

    <param name="moveit_controller_manager" value="moveit_simple_controller_manager/MoveItSimpleControllerManager"/>
    <rosparam command="load" file="$(arg config)/moveit_controllers.yaml"/>
    <param name="moveit_manage_controllers" value="true"/>
    <param name="trajectory_execution/allowed_execution_duration_scaling" value="1.2"/>
    <param name="trajectory_execution/allowed_goal_duration_margin" value="0.5"/>
    <param name="trajectory_execution/allowed_start_tolerance" value="0.01"/>
  </group>

  <node name="move_group" pkg="moveit_ros_move_group" type="move_group" output="screen"
        launch-prefix="$(eval 'gdb --ex run --args' if debug else '')">
    <env name="DISPLAY" value="$(optenv DISPLAY :0)"/>
    <param name="allow_trajectory_execution" value="$(arg allow_trajectory_execution)"/>
    <param name="default_planning_pipeline" value="$(arg pipeline)"/>
    <param name="monitor_dynamics" value="false"/>
    <!-- publish the planning scene of the robot so that the RViz plugin knows the actual robot -->
    <param name="planning_scene_monitor/publish_planning_scene" value="true"/>
    <param name="planning_scene_monitor/publish_geometry_updates" value="true"/>
    <param name="planning_scene_monitor/publish_state_updates" value="true"/>
    <param name="planning_scene_monitor/publish_transforms_updates" value="true"/>
  </node>
</launch>
