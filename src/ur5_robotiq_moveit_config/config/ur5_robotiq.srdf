  <disable_collisions link1="robotiq_arg2f_base_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="robotiq_arg2f_base_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_arg2f_base_link" link2="wrist_camera_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_camera_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_camera_link" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="wrist_camera_link" reason="Adjacent"/>
  <!-- gripper linkage: its links touch each other by design -->
  <disable_collisions link1="left_inner_knuckle" link2="left_inner_finger" reason="Default"/>
  <disable_collisions link1="right_inner_knuckle" link2="right_inner_finger" reason="Default"/>
</robot>
