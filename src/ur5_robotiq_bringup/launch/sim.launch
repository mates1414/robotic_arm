<?xml version="1.0"?>
<!-- UR5 + Robotiq 2F-85 in Gazebo 11 with ros_control.

     Loads this project's URDF, starts robot_state_publisher and wraps ur_gazebo/launch/inc/ur_control.launch.xml
     (Gazebo, spawn, controller spawners) with this project's controllers and world. -->
<launch>
  <arg name="gui" default="true" doc="Start the Gazebo GUI?"/>
  <arg name="launch_rviz" default="true" doc="Launch RViz?"/>
  <arg name="world_file" default="$(find ur5_robotiq_bringup)/worlds/ur5_workcell.world" doc="Gazebo world"/>

  <param name="robot_description"
         command="$(find xacro)/xacro $(find ur5_robotiq_description)/urdf/ur5_robotiq.urdf.xacro"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
    <param name="publish_frequency" value="125"/>
  </node>

  <include file="$(find ur_gazebo)/launch/inc/ur_control.launch.xml">
    <arg name="controller_config_file" value="$(find ur5_robotiq_bringup)/config/ur5_robotiq_controllers.yaml"/>
    <arg name="controllers" value="joint_state_controller pos_joint_traj_controller gripper_controller"/>
    <arg name="stopped_controllers" value="joint_group_pos_controller"/>
    <arg name="gazebo_model_name" value="ur5_robotiq"/>
    <arg name="gazebo_world" value="$(arg world_file)"/>
    <arg name="gui" value="$(arg gui)"/>
    <!-- the URDF fixes base_link to the world at the origin; a spawn height would only shift the Gazebo model -->
    <arg name="spawn_z" value="0.0"/>
    <!-- Start in the `home` state of ur5_robotiq_moveit_config. Gazebo starts paused and spawn_model unpauses it
         (-unpause, appended here because ur_control.launch.xml has no argument for it) once the joints are set;
         otherwise the arm falls before the controllers are up and they hold it wherever it landed. -->
    <arg name="paused" value="true"/>
    <arg name="initial_joint_positions"
         value="-J shoulder_pan_joint 0.0 -J shoulder_lift_joint -1.57 -J elbow_joint 1.57
                -J wrist_1_joint -1.57 -J wrist_2_joint -1.57 -J wrist_3_joint 0.0 -unpause"/>
  </include>

  <node if="$(arg launch_rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find ur_description)/cfg/view_robot.rviz"/>
</launch>
